#chat-container {
    height: 1fr;      /* take all remaining vertical space */
    padding: 1 2;
}

#bottom {
    dock: bottom;
    height: auto;
}

Chatbox {
    height: auto;     /* only as tall as its content */
    padding: 0 1;
    margin-bottom: 1;
}

.chatbox--user {
    border-left: thick $accent;
}

.chatbox--thinking {
    color: $text-muted;   /* visually subordinate to the answer text */
    border-left: thick $secondary;
    text-style: italic;
}

.chatbox--assistant {
    border-left: thick $success;
}

.chatbox--system {
    color: $text-muted;   /* command replies — informational, not conversation */
    border-left: thick $warning;
}

ModelBar {
    height: 3;
    padding: 0 1;
}

ModelBar #endpoint {
    width: auto;
    height: 3;
    content-align: left middle;
    color: $text-muted;
    margin-right: 1;
}

ModelBar #status {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

ModelBar #model-select {
    width: 28;
}

.chatbox--error {
    color: $error;
    border-left: thick $error;
}
.chatbox--tool-call {
    color: $text-muted;       /* the model's request to run a tool */
    border-left: thick $primary;
    text-style: italic;
}

.chatbox--tool-result {
    color: $text-muted;       /* tool output, subordinate to the conversation */
    border-left: thick $primary-darken-2;
}

.chatbox--tool-error {
    color: $error;
    border-left: thick $error;
    text-style: italic;
}

ApprovalModal {
    align: center middle;   /* center the dialog; ModalScreen dims the rest */
}

#approval-box {
    width: 64;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#approval-title {
    text-style: bold;
    color: $warning;
}

#approval-cmd {
    color: $text;
    margin: 1 0;
}

#approval-hint {
    color: $text-muted;
}

.chatbox--plan {
    color: $text;
    border-left: thick $secondary;   /* the plan/checklist stands out from tool output */
}

ModelBar #mode-select {
    width: 12;
}
