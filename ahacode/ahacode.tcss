#chat-container {
    height: 1fr;      /* take all remaining vertical space */
    padding: 1 2;
}

#bottom {
    dock: bottom;
    height: auto;
}

/* Multi-line prompt (TextArea). Taller than a one-line Input and grows with the
   text up to a cap; rounded to match the other boxes. */
#prompt {
    height: auto;
    min-height: 4;
    max-height: 12;
    border: round $primary-darken-2;
    background: $surface;
}

Chatbox {
    height: auto;     /* only as tall as its content */
    padding: 0 1;
    margin-bottom: 1;
}

.chatbox--user {
    border-left: thick $accent;
}

.chatbox--thinking {
    color: $text-muted;   /* visually subordinate to the answer text */
    border-left: thick $secondary;
    text-style: italic;
}

/* One assistant turn (thinking → tools → answer) is wrapped in a .turn container
   with a green left rail, so the whole flow reads as one connected group instead
   of a flat stack of toggles. The answer's own border is dropped — the rail is
   the green line now. */
.turn {
    height: auto;
    border-left: thick $success;
    padding: 0 0 0 1;
    margin-bottom: 1;
}
/* .chatbox--assistant has no own border now — the enclosing .turn rail is the
   green line. (Rule intentionally omitted so it inherits the base Chatbox.) */

/* A spawned sub-agent renders into a foldable 🤖 card (Collapsible, like
   ThinkingBlock). Its body carries a PURPLE left rail — one nesting level in — so a
   delegated task reads apart from the parent's green turn rail. */
.subagent-card {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 0 1 0;
}
.subagent-card > CollapsibleTitle {
    background: transparent;
    color: $secondary;
    text-style: bold;
}
.subagent-body {
    height: auto;
    border-left: thick $secondary;
    padding: 0 0 0 1;
    margin: 0;
}

.chatbox--system {
    color: $text-muted;   /* command replies — informational, not conversation */
    border-left: thick $warning;
}

/* The composer footer is 2 rows taller than its controls so the 3-row controls sit
   INSIDE it with a row of breathing space above and below, rather than filling it
   edge to edge. A filled button (Send/Stop) reads as touching the panel edges when
   it does; the outlined dropdowns hid it better, which is why only the button
   looked wrong. Padding, not per-control margins, so every control lines up. */
ModelBar {
    height: 5;
    padding: 1 1;
}

/* min-width, because 1fr is whatever the fixed controls leave over and on an 80-wide
   terminal that was 7 columns — enough for the bullet and nothing else, so a status
   line that had been extended to count elapsed seconds showed none of them. The
   model picker gives up the four columns; its long names truncate either way. */
ModelBar #status {
    width: 1fr;
    min-width: 18;
    height: 3;
    content-align: left middle;
    color: $text-muted;
    margin-left: 1;
}

ModelBar #model-select {
    width: 20;
}

.chatbox--error {
    color: $error;
    border-left: thick $error;
}
.chatbox--tool-call {
    color: $text-muted;       /* the model's request to run a tool */
    border-left: thick $primary;
    text-style: italic;
}

.chatbox--tool-result {
    color: $text-muted;       /* tool output, subordinate to the conversation */
    border-left: thick $primary-darken-2;
}

.chatbox--tool-error {
    color: $error;
    border-left: thick $error;
    text-style: italic;
}

ApprovalModal {
    align: center bottom;   /* rise from the bottom, near the prompt; ModalScreen dims the rest */
}

#approval-box {
    width: 88;
    max-width: 90%;
    height: auto;
    max-height: 90%;        /* keep the dialog on-screen even for big writes */
    padding: 1 2;
    margin-bottom: 1;       /* float just above the very bottom edge */
    border: round $warning;
    background: $surface;
}

#approval-title {
    text-style: bold;
    color: $warning;
}

/* Scrollable preview of the tool's effect (code / diff / command). Capped short
   enough that the title and Run/Skip buttons always stay visible; longer content
   scrolls inside this box. */
#approval-preview {
    height: auto;
    max-height: 15;
    margin: 0 0 1 0;
    color: $text;
}

#approval-buttons {
    height: auto;
    align-horizontal: right;   /* buttons sit at the bottom-right of the dialog */
}

#approval-buttons Button {
    margin-left: 2;
    min-width: 12;
}

ModelBar #mode-select {
    width: 12;
}

ModelBar #auto-approve {
    height: 3;
    content-align: left middle;
    border: none;
    background: transparent;
}

/* auto-approve: OFF shows an empty box (the ✓ is hidden by matching the box
   background); ON shows a green ✓ and a green label. */
ModelBar #auto-approve > .toggle--button {
    color: $panel;          /* ✓ invisible when off — blends into the box */
}
ModelBar #auto-approve.-on > .toggle--button {
    color: $success;        /* green ✓ when on */
}
ModelBar #auto-approve.-on > .toggle--label {
    color: $success;
    text-style: bold;
}

/* NOT docked: two widgets docked to the same edge overlap here (measured — the
   later one covers the HeaderBar), so the panel lives in normal flow instead. With
   HeaderBar docked top and #bottom docked bottom, a non-docked TodoPanel sits at the
   top of the remaining middle region — just under the header, above the chat — and
   collapses to nothing when hidden (display:none), giving the chat the full height. */
/* padding: top right bottom left. The bottom already reads as spaced because the
   border draws its own row there; the top had nothing, so the plan sat directly
   against the header's coloured band. One row of top padding balances it — it takes
   the app background rather than the header's panel colour, so it reads as a gap
   rather than as more header. */
/* max-height, because `height: auto` alone grows one row per step and rows are the
   scarce resource (see HeaderBar's rule). A 12-step plan took 15 of 24 rows and left
   the chat 2 — not enough to show the plan-gate card that the same plan had just
   opened, so the loop sat blocked on buttons nobody could scroll to. The panel is a
   reference; the decision on screen outranks it. Past the cap it scrolls. */
TodoPanel {
    height: auto;
    max-height: 40%;
    overflow-y: auto;
    padding: 1 2 0 2;
    border-bottom: solid $secondary;
    color: $text-muted;
}

TodoPanel.todo-panel--done {
    border-bottom: solid $success;
    color: $success;
}

/* edit diff as a green card: rounded border, path in the title, +N −M chip in the
   subtitle (Claude Code / the design-artifact look). Line colours come from the
   Rich diff text itself. */
.chatbox--tool-diff {
    border: round $success;
    border-title-color: $success;
    border-title-style: bold;
    border-subtitle-color: $success;
    padding: 0 1;
    margin-bottom: 1;
}

Settings {
    align: center middle;
}

/* Fixed height, not auto: the four panes differ in length, and an auto-sized box
   would resize under the cursor every time a tab is clicked. */
#settings-box {
    width: 78;
    height: 30;
    max-height: 90%;
    border: round $accent;
    background: $surface;
}

#settings-rail {
    width: 16;
    height: 100%;
    padding: 1 1 1 2;
    background: $panel;
}

#settings-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.settings-tab {
    width: 100%;
    height: 3;
    border: none;
    background: transparent;
    color: $text-muted;
    text-align: left;
}

.settings-tab.-active {
    background: $surface;
    color: $accent;
    text-style: bold;
}

#settings-right {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

#settings-panes {
    height: 1fr;
}

.settings-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#settings-right Select {
    margin-bottom: 1;
}

#settings-right Input {
    margin-bottom: 1;
}

/* The button and its result sit on one line so the status reads as the button's
   answer rather than as another field. */
#settings-fetch-row {
    height: auto;
    margin-bottom: 1;
}

#settings-fetch-status {
    color: $text-muted;
    margin-left: 2;
}

#settings-buttons {
    height: auto;
    margin-top: 1;
}

#settings-buttons Button {
    margin-right: 1;
}

SessionPicker {
    align: center middle;
}

#picker-box {
    width: 76;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#picker-head {
    height: 1;
    margin-bottom: 1;
}

#picker-heading {
    width: 1fr;
    text-style: bold;
    color: $accent;
}

#picker-close {
    margin-left: 1;
    min-width: 8;
}

#picker-title {
    color: $text-muted;
    margin-bottom: 1;
}

#picker-list {
    height: auto;
    max-height: 22;
}

/* One session per row: the title takes the width, the ✎ / 🗑 buttons sit at the
   right edge one cell tall (compact), so a click on them never reaches the row. */
.picker-row {
    height: 1;
}

.picker-row-title {
    width: 1fr;
}

.picker-rename-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
}

.picker-rename, .picker-delete {
    width: auto;
    min-width: 4;
    margin-left: 1;
}

/* Foldable reasoning block (Textual Collapsible). Blend it into the chat: no
   panel chrome, a muted italic title, and drop the inner bubble's left border
   since the Collapsible already provides the visual nesting. */
ThinkingBlock {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 1;
}

ThinkingBlock > CollapsibleTitle {
    background: transparent;
    color: $text-muted;
    text-style: italic;
}

ThinkingBlock .chatbox--thinking {
    border-left: none;
    margin: 0;
    padding: 0;
}

/* Tool result as a foldable card (Textual Collapsible, same as ThinkingBlock).
   Blend into the chat; the inner bubble keeps its tool-result/error colour but
   drops its own border since the Collapsible provides the nesting. */
ToolResultBlock {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 1;
}

ToolResultBlock > CollapsibleTitle {
    background: transparent;
}

ToolResultBlock.tool-block--ok > CollapsibleTitle {
    color: $text-muted;       /* results stay subordinate to the conversation */
}

ToolResultBlock.tool-block--error > CollapsibleTitle {
    color: $error;            /* a failed call reads red even while collapsed */
    text-style: italic;
}

/* The output sits in a dark "terminal" block (Claude Code's OUT look) so it reads
   as a distinct pane, not loose text under the header. */
ToolResultBlock .chatbox--tool-result,
ToolResultBlock .chatbox--tool-error {
    border-left: none;
    margin: 0;
    padding: 0 1;
    background: $background;
    border: round $primary-darken-3;
}

/* Top bar: session title (left) + New / Sessions buttons (right). Docked top; the
   TodoPanel is NOT docked (see its rule) so it flows just below without overlap. */
/* 3 rows, with the single row of content inset by one row of padding above and
   below. Equal space on both sides WITHOUT the bar growing: the buttons here are
   flat (border: none, 1 row) rather than the composer's bordered 3-row Send, which
   is what pays for the padding. Rows are the scarce resource — a 5-row header left
   only 4 rows of chat on an 80x24 terminal, too few for the plan-gate card, so its
   buttons could not be scrolled into view at all. */
HeaderBar {
    dock: top;
    height: 3;
    background: $panel;
    padding: 1 1;
}

#session-title {
    width: 1fr;
    height: 1;
    content-align: left middle;   /* vertically centre the title in the bar */
    text-style: bold;
    color: $text;
}

HeaderBar #endpoint {
    width: auto;
    height: 1;
    content-align: right middle;
    color: $text-muted;
    margin-right: 2;
}

/* Flat: no border box, so the button is the 1 row of its label. margin-left is
   wider than the bordered case because there is no border to separate them. */
.header-btn {
    height: 1;
    min-width: 0;
    border: none;
    margin-left: 2;
}

/* Composer Send button, right end of the ModelBar. */
ModelBar #send-btn {
    height: 3;
    min-width: 0;
    padding: 0 3;      /* a bit more breathing room around the label */
    margin-left: 1;
}

/* Select dropdowns float ABOVE the button with a gap (the composer is at the
   bottom): margin-bottom lifts the overlay clear of the control so it never covers
   it — the button stays visible and clickable to close (Claude Code style). */
ModelBar SelectOverlay {
    constrain: none inside;
    margin-bottom: 4;
}

/* The approve-before-executing card. A yellow rail marks it as a decision point —
   distinct from the green turn rail and the purple sub-agent body. */
.plan-gate {
    height: auto;
    border-left: thick $warning;
    background: $panel;
    padding: 0 1;
    margin: 1 0;
}
.plan-gate--settled {
    border-left: thick $panel-lighten-2;
}
.plan-gate-title {
    text-style: bold;
    padding: 0 0 1 0;
}
.plan-gate-steps {
    color: $text-muted;
    padding: 0 0 1 0;
}
.plan-gate-buttons {
    height: auto;
    align-horizontal: left;
}
.plan-gate-buttons Button {
    margin: 0 1 0 0;
    min-width: 16;
}
