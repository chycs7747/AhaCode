#chat-container {
    height: 1fr;      /* take all remaining vertical space */
    padding: 1 2;
}

#bottom {
    dock: bottom;
    height: auto;
}

Chatbox {
    height: auto;     /* only as tall as its content */
    padding: 0 1;
    margin-bottom: 1;
}

.chatbox--user {
    border-left: thick $accent;
}

.chatbox--thinking {
    color: $text-muted;   /* visually subordinate to the answer text */
    border-left: thick $secondary;
    text-style: italic;
}

.chatbox--assistant {
    border-left: thick $success;
}

.chatbox--system {
    color: $text-muted;   /* command replies — informational, not conversation */
    border-left: thick $warning;
}

ModelBar {
    height: 3;
    padding: 0 1;
}

ModelBar #endpoint {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $text-muted;
}

ModelBar #model-select {
    width: 28;
}

.chatbox--error {
    color: $error;
    border-left: thick $error;
}