#chat-container {
    height: 1fr;      /* take all remaining vertical space */
    padding: 1 2;
}

#bottom {
    dock: bottom;
    height: auto;
}

/* Multi-line prompt (TextArea). Taller than a one-line Input and grows with the
   text up to a cap; rounded to match the other boxes. */
#prompt {
    height: auto;
    min-height: 4;
    max-height: 12;
    border: round $primary-darken-2;
    background: $surface;
}

Chatbox {
    height: auto;     /* only as tall as its content */
    padding: 0 1;
    margin-bottom: 1;
}

.chatbox--user {
    border-left: thick $accent;
}

.chatbox--thinking {
    color: $text-muted;   /* visually subordinate to the answer text */
    border-left: thick $secondary;
    text-style: italic;
}

/* One assistant turn (thinking → tools → answer) is wrapped in a .turn container
   with a green left rail, so the whole flow reads as one connected group instead
   of a flat stack of toggles. The answer's own border is dropped — the rail is
   the green line now. */
.turn {
    height: auto;
    border-left: thick $success;
    padding: 0 0 0 1;
    margin-bottom: 1;
}
/* .chatbox--assistant has no own border now — the enclosing .turn rail is the
   green line. (Rule intentionally omitted so it inherits the base Chatbox.) */

.chatbox--system {
    color: $text-muted;   /* command replies — informational, not conversation */
    border-left: thick $warning;
}

ModelBar {
    height: 3;
    padding: 0 1;
}

ModelBar #status {
    width: 1fr;
    height: 3;
    content-align: left middle;
    color: $text-muted;
    margin-left: 1;
}

ModelBar #model-select {
    width: 24;
}

.chatbox--error {
    color: $error;
    border-left: thick $error;
}
.chatbox--tool-call {
    color: $text-muted;       /* the model's request to run a tool */
    border-left: thick $primary;
    text-style: italic;
}

.chatbox--tool-result {
    color: $text-muted;       /* tool output, subordinate to the conversation */
    border-left: thick $primary-darken-2;
}

.chatbox--tool-error {
    color: $error;
    border-left: thick $error;
    text-style: italic;
}

ApprovalModal {
    align: center bottom;   /* rise from the bottom, near the prompt; ModalScreen dims the rest */
}

#approval-box {
    width: 88;
    max-width: 90%;
    height: auto;
    max-height: 90%;        /* keep the dialog on-screen even for big writes */
    padding: 1 2;
    margin-bottom: 1;       /* float just above the very bottom edge */
    border: round $warning;
    background: $surface;
}

#approval-title {
    text-style: bold;
    color: $warning;
}

/* Scrollable preview of the tool's effect (code / diff / command). Capped short
   enough that the title and Run/Skip buttons always stay visible; longer content
   scrolls inside this box. */
#approval-preview {
    height: auto;
    max-height: 15;
    margin: 0 0 1 0;
    color: $text;
}

#approval-buttons {
    height: auto;
    align-horizontal: right;   /* buttons sit at the bottom-right of the dialog */
}

#approval-buttons Button {
    margin-left: 2;
    min-width: 12;
}

.chatbox--plan {
    color: $text;
    border-left: thick $secondary;   /* the plan/checklist stands out from tool output */
}

ModelBar #mode-select {
    width: 12;
}

ModelBar #auto-approve {
    height: 3;
    content-align: left middle;
    border: none;
    background: transparent;
}

TodoPanel {
    dock: top;
    height: auto;
    padding: 0 2;
    border-bottom: solid $secondary;
    color: $text-muted;
}

TodoPanel.todo-panel--done {
    border-bottom: solid $success;
    color: $success;
}

/* edit diff as a green card: rounded border, path in the title, +N −M chip in the
   subtitle (Claude Code / the design-artifact look). Line colours come from the
   Rich diff text itself. */
.chatbox--tool-diff {
    border: round $success;
    border-title-color: $success;
    border-title-style: bold;
    border-subtitle-color: $success;
    padding: 0 1;
    margin-bottom: 1;
}

SessionPicker {
    align: center middle;
}

#picker-box {
    width: 76;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#picker-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#picker-list {
    height: auto;
    max-height: 22;
}

/* Foldable reasoning block (Textual Collapsible). Blend it into the chat: no
   panel chrome, a muted italic title, and drop the inner bubble's left border
   since the Collapsible already provides the visual nesting. */
ThinkingBlock {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 1;
}

ThinkingBlock > CollapsibleTitle {
    background: transparent;
    color: $text-muted;
    text-style: italic;
}

ThinkingBlock .chatbox--thinking {
    border-left: none;
    margin: 0;
    padding: 0;
}

/* Tool result as a foldable card (Textual Collapsible, same as ThinkingBlock).
   Blend into the chat; the inner bubble keeps its tool-result/error colour but
   drops its own border since the Collapsible provides the nesting. */
ToolResultBlock {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 1;
}

ToolResultBlock > CollapsibleTitle {
    background: transparent;
}

ToolResultBlock.tool-block--ok > CollapsibleTitle {
    color: $text-muted;       /* results stay subordinate to the conversation */
}

ToolResultBlock.tool-block--error > CollapsibleTitle {
    color: $error;            /* a failed call reads red even while collapsed */
    text-style: italic;
}

ToolResultBlock .chatbox--tool-result,
ToolResultBlock .chatbox--tool-error {
    border-left: none;
    margin: 0;
    padding: 0;
}

/* Top bar: session title (left) + New / Sessions buttons (right). Docked above
   the TodoPanel; both dock:top so they stack in mount order (HeaderBar first). */
HeaderBar {
    dock: top;
    height: 3;
    background: $panel;
    padding: 0 1;
}

#session-title {
    width: 1fr;
    height: 3;
    content-align: left middle;   /* vertically centre the title in the bar */
    text-style: bold;
    color: $text;
}

HeaderBar #endpoint {
    width: auto;
    height: 3;
    content-align: right middle;
    color: $text-muted;
    margin-right: 2;
}

.header-btn {
    height: 3;
    min-width: 0;
    margin-left: 1;
}

/* Composer Send button, right end of the ModelBar. */
ModelBar #send-btn {
    height: 3;
    min-width: 0;
    margin-left: 1;
}
